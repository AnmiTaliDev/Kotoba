{
  "id": "latin",
  "name": "English",
  "locale": "en",
  "order": 0,
  "defaultLayer": "letters",
  "punctuation": {
    "sentenceEnd": ".!?",
    "doubleSpace": "."
  },
  "numberRow": ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"],
  "layers": {
    "letters": {
      "label": "ABC",
      "shiftable": true,
      "numberRow": true,
      "rows": [
        ["q", "w", "e", "r", "t", "y", "u", "i", "o", "p"],
        [
          {"type": "spacer", "weight": 0.5},
          "a", "s", "d", "f", "g", "h", "j", "k", "l",
          {"type": "spacer", "weight": 0.5}
        ],
        [
          {"type": "shift", "weight": 1.5},
          "z", "x", "c", "v", "b", "n", "m",
          {"type": "delete", "weight": 1.5}
        ],
        [
          {"type": "layer", "layer": "symbols", "weight": 1.2},
          {"type": "language", "label": "Language", "icon": "ic_key_language"},
          ",",
          {"type": "layer", "label": "Emoji", "icon": "ic_key_emoji", "layer": "emoji"},
          {"type": "space", "weight": 3.6},
          ".",
          {"type": "enter", "weight": 1.3}
        ]
      ]
    },
    "emoji": {
      "kind": "emoji",
      "shiftable": false,
      "back": {"layer": "letters"}
    },
    "symbols": {
      "label": "?123",
      "shiftable": false,
      "rows": [
        ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"],
        ["@", "#", "$", "_", "&", "-", "+", "(", ")", "/"],
        [
          {"type": "layer", "layer": "symbols2", "weight": 1.5},
          "*", "\"", "'", ":", ";", "!", "?",
          {"type": "delete", "weight": 1.5}
        ],
        [
          {"type": "layer", "layer": "letters", "weight": 1.4},
          ",",
          {"type": "space", "weight": 5},
          ".",
          {"type": "enter", "weight": 1.5}
        ]
      ]
    },
    "symbols2": {
      "label": "=\\<",
      "shiftable": false,
      "rows": [
        ["~", "`", "|", "•", "√", "π", "÷", "×", "¶", "∆"],
        ["£", "¢", "€", "¥", "^", "°", "=", "{", "}", "\\"],
        [
          {"type": "layer", "layer": "symbols", "weight": 1.5},
          "%", "©", "®", "™", "✓", "[", "]",
          {"type": "delete", "weight": 1.5}
        ],
        [
          {"type": "layer", "layer": "letters", "weight": 1.4},
          ",",
          {"type": "space", "weight": 5},
          ".",
          {"type": "enter", "weight": 1.5}
        ]
      ]
    }
  }
}
