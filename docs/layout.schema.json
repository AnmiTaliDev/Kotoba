{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kotoba keyboard layout",
  "type": "object",
  "required": ["id", "name", "locale"],
  "properties": {
    "formatVersion": { "type": "integer", "minimum": 1, "maximum": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9_-]{1,32}$" },
    "name": { "type": "string", "minLength": 1 },
    "locale": { "type": "string", "minLength": 2 },
    "extends": { "type": "string" },
    "defaultLayer": { "type": "string" },
    "autoCapitalize": { "type": "boolean" },
    "punctuation": {
      "type": "object",
      "properties": {
        "sentenceEnd": { "type": "string" },
        "doubleSpace": { "type": "string" }
      }
    },
    "numberRow": { "type": "array", "items": { "$ref": "#/$defs/key" } },
    "layers": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9_-]{1,32}$" },
      "additionalProperties": { "$ref": "#/$defs/layer" }
    }
  },
  "allOf": [
    {
      "if": { "not": { "required": ["extends"] } },
      "then": { "required": ["defaultLayer", "punctuation", "layers"] }
    }
  ],
  "$defs": {
    "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
    "label": { "type": "string", "minLength": 1, "maxLength": 8 },
    "alternatives": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/label" } },
    "layer": {
      "type": "object",
      "properties": {
        "kind": { "enum": ["keys", "emoji"] },
        "shiftable": { "type": "boolean" },
        "numberRow": { "type": "boolean" },
        "rows": {
          "type": "array",
          "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/key" } }
        },
        "back": {
          "type": "object",
          "required": ["label", "layer"],
          "properties": {
            "label": { "type": "string" },
            "layer": { "type": "string" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "emoji" } }, "required": ["kind"] },
          "then": { "required": ["back"] },
          "else": { "required": ["rows"] }
        }
      ]
    },
    "key": {
      "oneOf": [
        { "$ref": "#/$defs/label" },
        {
          "type": "object",
          "properties": {
            "type": { "enum": ["char", "shift", "delete", "enter", "space", "spacer", "layer"] },
            "weight": { "$ref": "#/$defs/weight" },
            "label": { "type": "string" },
            "shifted": { "$ref": "#/$defs/label" },
            "hold": { "$ref": "#/$defs/alternatives" },
            "holdShifted": { "$ref": "#/$defs/alternatives" },
            "layer": { "type": "string" },
            "icon": { "type": "string" }
          },
          "allOf": [
            {
              "if": { "properties": { "type": { "const": "layer" } }, "required": ["type"] },
              "then": { "required": ["label", "layer"] }
            },
            {
              "if": { "not": { "required": ["type"] } },
              "then": { "required": ["label"] }
            },
            {
              "if": { "properties": { "type": { "const": "char" } }, "required": ["type"] },
              "then": { "required": ["label"], "properties": { "label": { "$ref": "#/$defs/label" } } }
            }
          ]
        }
      ]
    }
  }
}
